# Hosted Otari.ai — the hackathon requirement, and the default.
OTARI_BASE_URL=https://otari.ai/api/v1
OTARI_API_KEY=
# Take these three names from GET /api/v1/models on the deployment you use.
OTARI_MODEL_TRIAGE=
OTARI_MODEL_WRITE=
OTARI_MODEL_FALLBACK=

# Self-hosted gateway instead (same API, one image):
# OTARI_BASE_URL=http://localhost:8010/api/v1
# OTARI_WEB_FETCH_ENABLED=true is set on the gateway, not here.

# Per-user limits enforced by this app before any model call.
USER_MAX_TOKENS=60000
USER_MAX_RUNS=6
USER_WINDOW_MINUTES=60

# "off" uses the app's own fetcher instead of the gateway's otari_web_fetch.
OTARI_WEB_FETCH=on

# Optional: the gateway's own end-user budget, for a service key.
# OTARI_END_USER_BUDGET=
